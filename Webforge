cat > bin/webforge-gate-check <<'EOF'
#!/usr/bin/env node
import { readFileSync, existsSync } from 'fs';
const gates = [
  { name: 'Sécurité', file: 'SECURITY.md', rule: s => !/CVE-(CRITICAL|HIGH)/.test(s) },
  { name: 'Légal', file: 'legal/mentions-legales.md', rule: s => s.length > 500 },
  { name: 'RGPD', file: 'legal/politique-confidentialite.md', rule: s => /registre|art\. 30/i.test(s) },
  { name: 'Perf', file: 'PERF-REPORT.md', rule: s => /Lighthouse:\s*(9[5-9]|100)/.test(s) }
];
let failed = false;
for (const g of gates) {
  if (!existsSync(g.file)) { console.error(`❌ ${g.name}: manquant`); failed = true; continue; }
  const c = readFileSync(g.file, 'utf8');
  if (!g.rule(c)) { console.error(`❌ ${g.name}: gate non vert`); failed = true; }
  else console.log(`✅ ${g.name}: OK`);
}
process.exit(failed ? 1 : 0);
EOF

cat > bin/webforge-legal-scan <<'EOF'
#!/usr/bin/env node
import { readFileSync } from 'fs';
const input = JSON.parse(readFileSync(0, 'utf8'));
const content = input.tool_input?.content || '';
const path = input.tool_input?.file_path || '';
const forbidden = [
  { re: /(AKIA|ASIA)[A-Z0-9]{16}/, msg: 'AWS key' },
  { re: /sk-[a-zA-Z0-9]{32,}/, msg: 'OpenAI/Stripe key' },
  { re: /-----BEGIN (RSA|PRIVATE)/, msg: 'Clé privée' }
];
for (const f of forbidden) {
  if (f.re.test(content)) {
    console.error(`🚫 ${f.msg} dans ${path}. Bloqué.`);
    process.exit(1);
  }
}
process.exit(0);
EOF

cat > bin/webforge-danger-guard <<'EOF'
#!/usr/bin/env node
import { readFileSync } from 'fs';
const input = JSON.parse(readFileSync(0, 'utf8'));
const cmd = input.tool_input?.command || '';
const dangers = [
  /rm\s+-rf\s+\//,
  /:\(\)\{.*\};:/,
  /curl\s+[^|]+\|\s*(sh|bash)/,
  /wget\s+[^|]+\|\s*(sh|bash)/,
  /dd\s+if=.*of=\/dev\//
];
for (const d of dangers) {
  if (d.test(cmd)) { console.error(`🚫 Commande destructive bloquée: ${cmd}`); process.exit(1); }
}
process.exit(0);
EOF

cat > bin/webforge-notify <<'EOF'
#!/usr/bin/env node
import { argv } from 'process';
const [,, provider, recipient, title, body] = argv;
const providers = {
  telegram: async (to, t, b) => {
    const token = process.env.TELEGRAM_BOT_TOKEN;
    await fetch(`https://api.telegram.org/bot${token}/sendMessage`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ chat_id: to, text: `🔔 ${t}\n\n${b}` })
    });
  },
  ntfy: async (to, t, b) => {
    await fetch(`https://ntfy.sh/${to}`, { method: 'POST', body: `${t}\n${b}` });
  }
};
await providers[provider]?.(recipient, title, body);
console.log(`✅ Envoyé à ${recipient} via ${provider}`);
EOF

